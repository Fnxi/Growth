# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Security foundations. JWT is optional in local development until identity exists.
# In production, configure unpadded Base64URL values for random 32+ byte secrets.
# Generate one with: python -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('='))"
# SECURITY_JWT_ACTIVE_KID=2026-01
# SECURITY_JWT_KEYRING={"2026-01":"replace-with-generated-base64url-value"}
SECURITY_JWT_ISSUER=growth-hacking-lab
SECURITY_JWT_AUDIENCE=growth-hacking-lab-api
SECURITY_ACCESS_TOKEN_MINUTES=10
SECURITY_REFRESH_TOKEN_DAYS=14
SECURITY_SESSION_MAX_DAYS=30
SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
SECURITY_DOCS_ENABLED=true
SECURITY_COOKIE_SECURE=false
SECURITY_COOKIE_SAMESITE=lax
SECURITY_HSTS_ENABLED=false
SECURITY_AUTH_RATE_LIMIT=5
SECURITY_AUTH_RATE_WINDOW_SECONDS=60
SECURITY_REFRESH_RATE_LIMIT=10
SECURITY_REFRESH_RATE_WINDOW_SECONDS=60

# PostgreSQL (local Docker only; never commit real credentials)
POSTGRES_DB=growth_lab
POSTGRES_USER=growth_lab
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://growth_lab:change-me-local-only@localhost:5432/growth_lab

# Tracking propio: destinos HTTPS autorizados, separados por coma
TRACKING_BASE_URL=http://127.0.0.1:8000
TRACKING_ALLOWED_DESTINATION_HOSTS=instagram.com,www.instagram.com
TRACKING_RATE_LIMIT=30
TRACKING_RATE_WINDOW_SECONDS=60

# Internal infrastructure check endpoint. Leave unset to disable POST /system/check.
SYSTEM_CHECK_TOKEN=

# Independent infrastructure scheduler
MONITORING_SCHEDULER_ENABLED=false
MONITORING_CHECK_INTERVAL_SECONDS=60

# AI assistant. Keep the API key only in the backend environment.
AI_ENABLED=false
AI_PROVIDER=openai
AI_OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=700
AI_MAX_CONTEXT_CHARACTERS=12000
AI_RATE_LIMIT=10
AI_RATE_WINDOW_SECONDS=60
AI_MAX_CONCURRENT_REQUESTS=2
